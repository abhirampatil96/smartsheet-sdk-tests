{
  "request": {
    "urlPathTemplate": "/2.0/groups/{groupId}/members",
    "method": "POST",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/groups/add-group-members/single-member-all-response-body-properties"
      },
      "x-request-id": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "message": "SUCCESS",
      "resultCode": 0,
      "result": {
        "id": 1234567890123456,
        "email": "member1@example.com",
        "firstName": "John",
        "lastName": "Doe",
        "name": "John Doe"
      }
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
