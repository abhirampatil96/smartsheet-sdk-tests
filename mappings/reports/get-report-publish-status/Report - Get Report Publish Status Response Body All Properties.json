{
  "request": {
    "urlPathTemplate": "/2.0/reports/{reportId}/publish",
    "method": "GET",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/reports/get-report-publish-status/all-response-body-properties"
      },
      "x-request-id": {
        "matches" : ".*"
      }
    }
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "readOnlyFullAccessibleBy": "ALL",
      "readOnlyFullDefaultView": "GRID",
      "readOnlyFullEnabled": true,
      "readOnlyFullUrl": "https://publish.smartsheet.com/12345abcde",
      "readOnlyFullShowToolbar": true
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
