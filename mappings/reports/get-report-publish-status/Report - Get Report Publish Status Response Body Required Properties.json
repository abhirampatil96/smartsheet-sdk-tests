{
  "request": {
    "urlPathPattern": "/2.0/reports/[0-9]+/publish",
    "method": "GET",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/reports/get-report-publish-status/required-response-body-properties"
      },
      "x-request-id": {
        "matches" : ".*"
      }
    }
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "readOnlyFullDefaultView": "GRID",
      "readOnlyFullEnabled": false
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
