{
  "request": {
    "urlPathTemplate": "/2.0/folders/{folderId}/copy",
    "method": "POST",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/folders/copy-folder/all-response-body-properties"
      },
      "x-request-id": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "destinationType": "folder",
      "destinationId": 9876543210123456,
      "newName": "Copied Folder"
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
