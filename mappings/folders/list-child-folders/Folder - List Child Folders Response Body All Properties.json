{
  "request": {
    "urlPathTemplate": "/2.0/folders/{folderId}/folders",
    "method": "GET",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/folders/list-child-folders/all-response-body-properties"
      },
      "x-request-id": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "pageNumber": 1,
      "pageSize": 100,
      "totalPages": 1,
      "totalCount": 2,
      "result": [
        {
          "id": 1234567890123456,
          "name": "Child Folder 1",
          "permalink": "https://app.smartsheet.com/folders/1234567890123456"
        },
        {
          "id": 2234567890123456,
          "name": "Child Folder 2",
          "permalink": "https://app.smartsheet.com/folders/2234567890123456"
        }
      ]
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
