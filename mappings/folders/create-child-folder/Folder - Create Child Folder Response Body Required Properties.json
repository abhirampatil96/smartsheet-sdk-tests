{
  "request": {
    "urlPathTemplate": "/2.0/folders/{folderId}/folders",
    "method": "POST",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/folders/create-child-folder/required-response-body-properties"
      },
      "x-request-id": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "message": "SUCCESS",
      "resultCode": 0,
      "result": {
        "id": 3456789012345678,
        "name": "New Child Folder",
        "permalink": "https://app.smartsheet.com/folders/3456789012345678"
      }
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
