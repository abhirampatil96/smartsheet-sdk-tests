{
  "request": {
    "urlPathTemplate": "/2.0/favorites/{favoriteType}/{favoriteId}",
    "method": "GET",
    "headers": {
      "Authorization": {
        "matches": "Bearer .*"
      },
      "x-test-name": {
        "equalTo": "/favorites/is-favorite/required-response-body-properties"
      },
      "x-request-id": {
        "matches": ".*"
      }
    }
  },
  "response": {
    "statusMessage": "OK",
    "status": 200,
    "jsonBody": {
      "type": "sheet",
      "objectId": 1234567890
    },
    "headers": {
      "Content-Type": "application/json"
    }
  }
}
